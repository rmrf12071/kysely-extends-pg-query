{
  "name": "kysely-extends-pg-query",
  "version": "0.2.4",
  "description": "kysely plugin for PostgreSQL",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "test:simple": "node --test \"test/**/*.test.ts\"",
    "pre-publish": "npm run test:simple && npm run build && npm publish --dry-run",
    "test:unit": "node --test \"test/plugin/**/*.test.ts\"",
    "test:types": "tsc --project tsconfig.test.json",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "bin": {
    "kysely-extends-pg-query": "dist/bin/node.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmrf12071/kysely-extends-pg-query.git"
  },
  "author": "rmrf12071",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rmrf12071/kysely-extends-pg-query/issues"
  },
  "homepage": "https://github.com/rmrf12071/kysely-extends-pg-query#readme",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg-pool": "^2.0.6",
    "kysely": "^0.27.3",
    "pg-pool": "^3.6.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "kysely": "^0.27.3"
  },
  "dependencies": {
    "esbuild-register": "^3.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
